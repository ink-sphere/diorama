      "refersTo": "search",
      "description": "A transparent title, author, or run filter.",
      "html": "<label class=\"ds-search\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"Search books\" placeholder=\"Search your library\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;color:var(--muted,#64695f)}.ds-search input{width:205px;padding:9px 2px;border:0;border-radius:0;background:transparent;color:var(--ink,#272c25);font:12px \"Work Sans\",sans-serif}.ds-search input::placeholder{color:var(--muted,#64695f);opacity:1}.ds-search input:focus-visible { outline: 2px solid var(--accent, #456044); outline-offset: 4px; }"
    },
    {
      "name": "Contents navigation",
      "kind": "nav",
      "refersTo": "contents-item",
      "description": "Separate branch disclosure and selectable group/text nodes preserve the source hierarchy.",
      "html": "<nav class=\"ds-contents\" aria-label=\"Book contents\"><ol><li><div class=\"ds-row\"><button class=\"ds-disclosure\" aria-label=\"Collapse Part one\" aria-expanded=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button><button class=\"ds-node\" aria-current=\"location\">Part one<span class=\"ds-type\">part</span></button></div><ol class=\"ds-children\"><li><div class=\"ds-row\"><span class=\"ds-spacer\"></span><button class=\"ds-node\">Chapter one<span class=\"ds-type\">chapter</span></button></div></li><li><div class=\"ds-row\"><span class=\"ds-spacer\"></span><button class=\"ds-node\">Chapter two<span class=\"ds-type\">chapter</span></button></div></li></ol></li></ol></nav>",
      "css": ".ds-contents{width:236px;color:var(--ink,#272c25);font:12px/1.5 \"Work Sans\",sans-serif}.ds-contents ol{list-style:none;margin:0;padding:0}.ds-contents .ds-children{padding-left:16px}.ds-row{display:flex;align-items:flex-start}.ds-node{flex:1;min-width:0;border:0;border-radius:5px;padding:11px 12px;text-align:left;background:transparent;color:inherit;font:inherit;cursor:pointer;overflow-wrap:anywhere}.ds-disclosure,.ds-spacer{width:24px;flex-shrink:0}.ds-disclosure{height:36px;margin-top:4px;display:flex;align-items:center;justify-content:center;padding:0;border:0;background:transparent;color:inherit;cursor:pointer}.ds-type{display:block;font-size:10px;color:var(--muted,#64695f);margin-top:4px}.ds-node:hover,.ds-node[aria-current]{background:var(--surface,#eeece4)}.ds-node[aria-current]{color:var(--accent,#456044);font-weight:500}.ds-contents button:focus-visible{outline:2px solid var(--accent,#456044);outline-offset:4px}"
    },
    {
