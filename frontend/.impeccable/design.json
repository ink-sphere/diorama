      "html": "<div class=\"ds-segmented\"><button aria-pressed=\"true\">Literata</button><button aria-pressed=\"false\">Work Sans</button></div>",
      "css": ".ds-segmented{display:flex;width:237px;background:var(--surface,#eeece4);border-radius:6px;padding:3px;gap:3px}.ds-segmented button{display:flex;align-items:center;justify-content:center;gap:7px;flex:1;border:0;border-radius:4px;padding:8px;background:transparent;color:var(--ink,#272c25);font:12px \"Work Sans\",sans-serif;cursor:pointer}.ds-segmented button[aria-pressed=\"true\"]{background:var(--paper,#f7f5ef);color:var(--accent,#456044)}.ds-segmented button:focus-visible { outline: 2px solid var(--accent, #456044); outline-offset: 4px; }"
    },
    {
      "name": "Settings panel",
      "kind": "card",
      "refersTo": "settings-panel",
      "description": "A floating panel for persistent reader preferences.",
      "html": "<section class=\"ds-panel\"><h3>Make yourself comfortable</h3><label>Text size <span>19px</span></label><input type=\"range\" aria-label=\"Text size\" min=\"15\" max=\"28\" value=\"19\"></section>",
      "css": ".ds-panel{box-sizing:border-box;width:285px;padding:24px;background:var(--paper,#f7f5ef);color:var(--ink,#272c25);box-shadow:0 10px 32px #00000024;border-radius:12px}.ds-panel h3{font:400 17px/1.45 \"Literata\",serif;margin:0 0 26px}.ds-panel label{display:flex;justify-content:space-between;font:12px \"Work Sans\",sans-serif}.ds-panel input{display:block;width:100%;margin:16px 0 24px;accent-color:var(--accent,#456044)}.ds-panel input:focus-visible { outline: 2px solid var(--accent, #456044); outline-offset: 4px; }"
    },
    {
      "name": "Ruled library row",
      "kind": "custom",
      "description": "A full-width opening action with the implemented missing-cover fallback.",
      "html": "<button class=\"ds-row\"><span class=\"ds-cover\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 7v14M3 18V3h3a6 6 0 0 1 6 4 6 6 0 0 1 6-4h3v15h-3a6 6 0 0 0-6 3 6 6 0 0 0-6-3z\"/></svg><span>Book title</span></span><span class=\"ds-information\"><span class=\"ds-author\">Author</span><strong>Book title</strong><span class=\"ds-metadata\">12 sections</span></span><span class=\"ds-action\">Start reading <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg></span></button>",
      "css": ".ds-row{display:flex;align-items:center;gap:28px;width:100%;padding:28px 0;text-align:left;border:0;border-bottom:1px solid var(--rule,#d9ddd2);background:transparent;color:var(--ink,#272c25);transition:background-color 180ms ease-out;cursor:pointer}.ds-row:hover:not(:disabled){background:#eeeee5}.ds-row:focus-visible { outline: 2px solid var(--accent, #456044); outline-offset: 4px; }.ds-cover{display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;flex-shrink:0;box-sizing:border-box;width:92px;height:130px;padding:13px;overflow:hidden;background:#e5e7dc;border-radius:3px 6px 6px 3px;box-shadow:2px 4px 8px #272c2514;color:var(--accent,#456044)}.ds-cover span{font:10px/1.35 \"Literata\",serif}.ds-information{flex:1;min-width:0}.ds-author{font:12px \"Work Sans\",sans-serif;color:var(--muted,#64695f)}.ds-information strong{display:block;font:400 23px/1.4 \"Literata\",serif;letter-spacing:-.018em;margin:7px 0 13px}.ds-metadata{font:11px \"Work Sans\",sans-serif;color:var(--muted,#64695f)}.ds-action{display:flex;align-items:center;gap:12px;flex-shrink:0;padding:0 6px 0 20px;color:var(--accent,#456044);font:500 12px \"Work Sans\",sans-serif}.ds-row:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:reduce){.ds-row{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The independent literary review",
    "overview": "An independent literary review frames local ebook runs as a calm reading library. Warm paper, Literata, restrained green, fine rules, and real ebook covers give the interface a quiet editorial character.\n\nThe reader preserves source hierarchy in a conventional nested contents rail and leaves a generous column for book content. Work Sans keeps navigation and settings distinct from the literary text; mobile disclosures and saved reading preferences support the same reading experience at smaller widths.",
    "keyCharacteristics": [
      "Warm paper and restrained green.",
      "Literata reading and headings; Work Sans interface.",
      "Ruled library rows with actual ebook covers.",
      "Nested contents and a generous reading column."
    ],
    "rules": [],
    "dos": [
      "Do use real ebook covers when available and the existing typographic fallback when unavailable.",
      "Do distinguish book typography from interface labels and keep source structure visible in contents.",
      "Do preserve visible keyboard focus, current-section states, and reduced-motion behavior.",
      "Do carry the paper/night palette through reader controls and preserve saved reading preferences."
    ],
    "donts": [
      "Don't replace the ruled library list with a dashboard card grid.",
      "Don't add ornamental imagery, gradients, or shadows behind book text.",
      "Don't invent book metadata or introduce generated artwork into the local library."
    ]
  }
}
